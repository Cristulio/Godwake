#!/usr/bin/env bash
# Create a new feature worktree for parallel Claude work.
#
# Usage:
#   scripts/wt-new <feature-name> [--launch]
#
# Examples:
#   scripts/wt-new quirks-expansion
#   scripts/wt-new bg2-imoen-rescue --launch
#
# Creates a worktree at ../DD-worktrees/<feature-name> on a new branch
# named feat/<feature-name>, copies .claude/settings.local.json into it so
# the new Claude session inherits permissions + shared memory, and (with
# --launch) opens a new Claude session in the worktree. On iTerm2 the new
# session splits into a pane of the current window — always vertically,
# so each new pane lands to the right of the existing strip (a 5-way
# fan-out becomes 5 side-by-side columns). Falls back to a new
# Terminal.app window if iTerm2 isn't installed.
#
# Pass --brief-file <path> to start the new Claude session with the file's
# contents as the first user message — the agent reads the brief and gets
# to work immediately instead of waiting for an initial prompt.
#
# Pass --model <model> and/or --effort <level> to forward those flags to the
# launched claude session (sets the spawned session's model and effort level).

set -euo pipefail

NAME=""
LAUNCH=0
BRIEF_FILE=""
MODEL=""
EFFORT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --launch)
      LAUNCH=1
      shift
      ;;
    --model)
      shift
      MODEL="${1:-}"
      if [ -z "$MODEL" ]; then
        echo "Error: --model requires an argument" >&2
        exit 1
      fi
      shift
      ;;
    --effort)
      shift
      EFFORT="${1:-}"
      if [ -z "$EFFORT" ]; then
        echo "Error: --effort requires an argument" >&2
        exit 1
      fi
      shift
      ;;
    --brief-file)
      shift
      BRIEF_FILE="${1:-}"
      if [ -z "$BRIEF_FILE" ]; then
        echo "Error: --brief-file requires a path argument" >&2
        exit 1
      fi
      shift
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
    *)
      if [ -z "$NAME" ]; then NAME="$1"; fi
      shift
      ;;
  esac
done

if [ -z "$NAME" ]; then
  echo "Usage: scripts/wt-new <feature-name> [--launch] [--brief-file <path>]"
  echo ""
  echo "Examples:"
  echo "  scripts/wt-new quirks-expansion"
  echo "  scripts/wt-new bg2-imoen-rescue --launch"
  echo "  scripts/wt-new continuous-delve --launch --brief-file .briefs/continuous-delve.md"
  echo ""
  echo "  --launch       Opens claude in the worktree (iTerm2 split pane, or Terminal.app)."
  echo "  --brief-file   Path to a markdown brief; sent as the agent's first message."
  echo "  --model        Model for the launched claude session (forwarded as --model)."
  echo "  --effort       Effort level for the launched claude session (forwarded as --effort)."
  exit 1
fi

if [ -n "$BRIEF_FILE" ] && [ ! -f "$BRIEF_FILE" ]; then
  echo "Error: brief file not found: $BRIEF_FILE" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
PARENT_DIR="$(dirname "$REPO_ROOT")"
WORKTREES_DIR="$PARENT_DIR/DD-worktrees"
WORKTREE_PATH="$WORKTREES_DIR/$NAME"
BRANCH="feat/$NAME"

if [ -d "$WORKTREE_PATH" ]; then
  echo "Error: $WORKTREE_PATH already exists." >&2
  exit 1
fi

mkdir -p "$WORKTREES_DIR"

echo "→ Creating worktree at $WORKTREE_PATH on branch $BRANCH"
git worktree add "$WORKTREE_PATH" -b "$BRANCH"

# Seed Claude settings so the new session has matching permissions + shared
# auto-memory pointer.
if [ -f "$REPO_ROOT/.claude/settings.local.json" ]; then
  mkdir -p "$WORKTREE_PATH/.claude"
  cp "$REPO_ROOT/.claude/settings.local.json" "$WORKTREE_PATH/.claude/settings.local.json"
  echo "→ Copied .claude/settings.local.json"
fi

echo ""
echo "✓ Worktree ready."
echo ""
echo "  Path:   $WORKTREE_PATH"
echo "  Branch: $BRANCH"

if [ "$LAUNCH" -eq 1 ]; then
  if ! command -v osascript >/dev/null 2>&1; then
    echo ""
    echo "Note: --launch requires macOS (osascript not found). Open a terminal manually:"
    echo "  cd \"$WORKTREE_PATH\" && npm install && claude"
    exit 0
  fi
  if [ -n "$BRIEF_FILE" ]; then
    cp "$BRIEF_FILE" "$WORKTREE_PATH/.briefing.md"
    echo "→ Copied brief into .briefing.md"
    # The shell command typed into the new session: cd, install if needed,
    # then run claude with the brief contents as the first user message.
    # \\\" → literal \" (AppleScript-escaped " inside the string)
    # \$   → literal $ (AppleScript has no $ interpolation, just pass it through)
    LAUNCH_CMD="cd '$WORKTREE_PATH' && export WT_AUTOCLOSE=1 && (test -d node_modules || npm install) && claude --dangerously-skip-permissions ${MODEL:+--model $MODEL} ${EFFORT:+--effort $EFFORT} \\\"\$(cat .briefing.md)\\\""
  else
    LAUNCH_CMD="cd '$WORKTREE_PATH' && export WT_AUTOCLOSE=1 && (test -d node_modules || npm install) && claude --dangerously-skip-permissions ${MODEL:+--model $MODEL} ${EFFORT:+--effort $EFFORT}"
  fi
  if [ -d "/Applications/iTerm.app" ]; then
    echo ""
    echo "→ Opening pane in iTerm2..."
    osascript <<EOF
tell application "iTerm"
  activate
  if (count of windows) = 0 then
    create window with default profile
    delay 3
    tell current session of current window to write text "$LAUNCH_CMD"
  else
    tell current window
      tell current tab
        -- Always split vertically: each new pane lands to the right of the
        -- current session. We target the LAST session in the tab (most
        -- recently added) so successive spawns cascade rightward in a strip.
        set sessionCount to (count of sessions)
        set rightmostSession to (session sessionCount)
        tell rightmostSession
          set newSession to (split vertically with default profile)
        end tell
        -- Wait for the new shell to finish init before typing. Without this,
        -- parallel wt-new fan-outs lose leading characters of the typed
        -- command (cd → rcd / icd / etc) because zsh isn't ready yet.
        delay 3
        tell newSession to write text "$LAUNCH_CMD"
      end tell
    end tell
  end if
end tell
EOF
    echo "✓ iTerm2 pane opened with claude running."
  else
    echo ""
    echo "→ Launching new Terminal window..."
    osascript <<EOF
tell application "Terminal"
  activate
  do script "$LAUNCH_CMD"
end tell
EOF
    echo "✓ New Terminal window opened with claude running."
  fi
else
  echo ""
  echo "Open a new terminal there to start a Claude session:"
  echo "  cd \"$WORKTREE_PATH\""
  echo "  npm install"
  echo "  claude"
  echo ""
  echo "Or run with --launch to auto-open: scripts/wt-new $NAME --launch"
fi

echo ""
echo "When merged: scripts/wt-clean $NAME"
